<resources>
    <!-- IMS: Enable VoLTE and VoWiFI capability at framework level -->
    <bool name="config_carrier_volte_available">true</bool>
    <bool name="config_device_volte_available">true</bool>
    <bool name="config_device_vt_available">true</bool>

    <!-- IMS: WLAN data/network service and QNS packages -->
    <string name="config_wlan_data_service_package">com.google.android.iwlan</string>
    <string name="config_wlan_network_service_package">com.google.android.iwlan</string>
    <string name="config_qualified_networks_service_package">com.android.telephony.qns</string>

    <!-- The bounding path of the cutout region of the main built-in display.
         Center punch-hole cutout; livedump cutoutSpec from SM-M558B. -->
    <string name="config_mainBuiltInDisplayCutout">M 0,0 M 0, 7.111111111111111 a 11.02222222222222,11.02222222222222 0 1,0 0,22.04444444444444 a 11.02222222222222,11.02222222222222 0 1,0 0,-22.04444444444444 Z @dp</string>

    <!-- Enable system navigation keys (3-button + gesture) -->
    <bool name="config_supportSystemNavigationKeys">true</bool>

    <!-- UDFPS: doze/long-press sensor type for under-display fingerprint -->
    <string name="config_dozeUdfpsLongPressSensorType" translatable="false">org.lineageos.sensor.udfps</string>

    <!-- UDFPS: enable fp unlock when screen turns off -->
    <bool name="config_screen_off_udfps_enabled">true</bool>

    <!-- UDFPS: default value for fp screen off unlock toggle -->
    <bool name="config_screen_off_udfps_default_on">false</bool>
</resources>
